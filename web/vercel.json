{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/_blob/:id", "destination": "/api/blob?id=:id" },
    { "source": "/_gh/:id", "destination": "/api/gh?id=:id" }
  ],
  "functions": { "api/sample.js": { "maxDuration": 300 }, "api/gh.js": { "maxDuration": 300 } },
  "headers": [{ "source": "/(index.html|shim.js)?", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }]
}
