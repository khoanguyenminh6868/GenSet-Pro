{
  "cleanUrls": true,
  "ignoreCommand": "[ \"$VERCEL_ENV\" != \"production\" ] || { git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . 2>/dev/null; [ $? -eq 0 ]; }",
  "rewrites": [
    { "source": "/_blob/:id", "destination": "/api/blob?id=:id" },
    { "source": "/_gh/:id", "destination": "/api/gh?id=:id" }
  ],
  "functions": { "api/gh.js": { "maxDuration": 300 }, "api/quote.js": { "maxDuration": 300 }, "api/lite.js": { "maxDuration": 60 } },
  "headers": [{ "source": "/(index.html|shim.js|busy.js|catalog.js|bidprice.js)?", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }]
}
