{
  "name": "genbid-pro-server",
  "version": "1.0.0",
  "description": "GenBid Pro API: muasamcong tender feed and Claude-powered analysis, translation and comparison",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check:portal": "tsx scripts/check-portal.ts",
    "export:feed": "tsx scripts/export-feed.ts",
    "lookup:tenders": "tsx scripts/lookup-tenders.ts"
  },
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "playwright-core": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true
}